}
plot(seq(1,1000,length=nrow(System3)), System3[,1], xlab="Time", ylab="Abundance",type="l",
main="SYSTEM3",col="orange",lwd=2,ylim=c(0,300),xlim=c(0,1000))
points(seq(1,1000,length=nrow(System3)), System3[,2], xlab="Time", ylab="Abundance",type="l",col="green",lwd=2,lty=2)
legend("top",lwd=c(2,2),lty=c(1,2),col=c("orange","green"),legend=c("prey","predator"),bty="n")
# plot the phases for each system
plot(1,1,pch="",ylim=c(0,400),xlim=c(0,400),xlab="species 1",ylab="species 2")
points(jitter(System[,1],200),jitter(System[,2],200),col="brown",pch=20,cex=0.3)
points(jitter(System1[,1],200),jitter(System1[,2],200),col="green",pch=20,cex=0.3)
points(jitter(System2[,1],200),jitter(System2[,2],200),col="red",pch=20,cex=0.3)
points(jitter(System3[,1],200),jitter(System3[,2],200),col="blue",pch=20,cex=0.3)
Alpha <- 0.01  # prey death rate due to depredation
Beta <- 0.001   # prey conversion efficiency by predator
InitPrey <- 100
InitPred <- 75
r <- 0.4        # prey population growth
q <- 0.3        # natural death rates of predators
Nyears <- 100
step <- 0.1
System <- data.frame(prey = rep(InitPrey,(Nyears*10+1)),pred = InitPred)
head(System)
doYear <- function(prevyear){
n1 <- prevyear[1] + r*prevyear[1]*step - Alpha*prevyear[1]*prevyear[2]*step
n2 <- prevyear[2] + Beta*prevyear[1]*prevyear[2]*step - q*prevyear[2]*step
return(c(n1,n2))
}
## Do simulation
for(i in 1:(Nyears*10+1)){
System[1+i,] <- doYear(System[i,])
}
head(System)
hist(System$prey)
hist(System$pred)
# predator and prey population trajectory
plot(seq(1,100,length=nrow(System)), System[,1], xlab="Time", ylab="Abundance",type="l",col="orange",lwd=2,ylim=c(0,2000),xlim=c(0,100))
points(seq(1,100,length=nrow(System)), System[,2], xlab="Time", ylab="Abundance",type="l",col="green",lwd=2,lty=2)
legend("top",lwd=c(2,2),lty=c(1,2),col=c("orange","green"),legend=c("prey","predator"),bty="n")
# phase plot
plot(1,1,pch="",ylim=c(0,250),xlim=c(0,2000),xlab="prey",ylab="predators")
points(System[c(1:1000),],col="green",type="p",pch=20,cex=0.85)
points(System[1,],col="blue",pch=20,cex=3)
# identify conditions under which both prey and predator populations do not grow
abline(h=r/Alpha,col="blue",lwd=3)   # prey
abline(v=q/Beta,col="red",lwd=3)   # pred
plot(1,1,pch="",ylim=c(0,250),xlim=c(0,2000),xlab="prey",ylab="predators")
points(jitter(System[,1],500),jitter(System[,2],500),col="brown",pch=20,cex=0.3)
